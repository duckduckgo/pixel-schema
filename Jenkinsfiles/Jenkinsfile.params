def validationConfigs(params) {
    return [
        [
            name: 'duckduckgo-privacy-extension',
            enabled: params.RUN_EXTENSION_VALIDATION,
            repo: 'duckduckgo-privacy-extension',
            branch: params.EXTENSION_BRANCH,
            definitionsDir: 'pixel-definitions',
            tagTemplate: params.EXTENSION_RELEASE_TAG_TEMPLATE,
        ],
        [
            name: 'windows-browser',
            enabled: params.RUN_WINDOWS_VALIDATION,
            repo: 'windows-browser',
            branch: params.WINDOWS_BROWSER_BRANCH,
            definitionsDir: 'PixelDefinitions',
            tagTemplate: params.WINDOWS_BROWSER_RELEASE_TAG_TEMPLATE,
            credentialsId: 'windows-browser-rw',
        ],
        [
            name: 'apple-browsers (macOS)',
            enabled: params.RUN_APPLE_VALIDATION,
            repo: 'apple-browsers',
            branch: params.APPLE_BROWSERS_BRANCH,
            definitionsDir: 'macOS/PixelDefinitions',
            tagTemplate: params.APPLE_MACOS_RELEASE_TAG_TEMPLATE,
        ],
        [
            name: 'apple-browsers (iOS)',
            enabled: params.RUN_APPLE_VALIDATION,
            repo: 'apple-browsers',
            branch: params.APPLE_BROWSERS_BRANCH,
            definitionsDir: 'iOS/PixelDefinitions',
            tagTemplate: params.APPLE_IOS_RELEASE_TAG_TEMPLATE,
        ],
        [
            name: 'android',
            enabled: params.RUN_ANDROID_VALIDATION,
            repo: 'android',
            branch: params.ANDROID_BRANCH,
            definitionsDir: 'PixelDefinitions',
            tagTemplate: params.ANDROID_RELEASE_TAG_TEMPLATE,
        ],
    ]
}

def remoteConfig(config) {
    def remote = [url: "https://github.com/duckduckgo/${config.repo}.git"]
    if (config.credentialsId) {
        remote.credentialsId = config.credentialsId
    }
    return remote
}

pipeline {
    agent { label 'ubuntu-latest' }
    triggers { cron('H 0 * * 0') }
    environment {
        USER_MAP="../internal-github-asana-utils/user_map.yml"
        ASANA_PROJECT="${params.ASANA_PROJECT ?: '1210856607616307'}"
        NOTIFY_PIXEL_OWNERS = "${params.NOTIFY_PIXEL_OWNERS}"
    }
    stages {
        stage('Setup parameters') {
            steps {
                script {
                    properties([
                        parameters([
                            string(
                                defaultValue: 'main',
                                description: 'Pixel Schema Branch',
                                name: 'PIXEL_SCHEMA_BRANCH'
                            ),
                            string(
                                defaultValue: 'develop',
                                description: 'Windows Browser Branch',
                                name: 'WINDOWS_BROWSER_BRANCH'
                            ),
                            string(
                                defaultValue: 'v{version}',
                                description: 'Windows Browser release tag template',
                                name: 'WINDOWS_BROWSER_RELEASE_TAG_TEMPLATE'
                            ),
                            booleanParam(
                                defaultValue: true,
                                description: 'Run Windows validation',
                                name: 'RUN_WINDOWS_VALIDATION'
                            ),
                            string(
                                defaultValue: 'main',
                                description: 'DuckDuckGo Extension Branch',
                                name: 'EXTENSION_BRANCH'
                            ),
                            string(
                                defaultValue: '{version}',
                                description: 'DuckDuckGo Extension release tag template',
                                name: 'EXTENSION_RELEASE_TAG_TEMPLATE'
                            ),
                            booleanParam(
                                defaultValue: true,
                                description: 'Run Extension validation',
                                name: 'RUN_EXTENSION_VALIDATION'
                            ),
                            string(
                                defaultValue: 'main',
                                description: 'Apple Browsers Branch',
                                name: 'APPLE_BROWSERS_BRANCH'
                            ),
                            string(
                                defaultValue: '{version}+macos',
                                description: 'Apple Browsers macOS release tag template',
                                name: 'APPLE_MACOS_RELEASE_TAG_TEMPLATE'
                            ),
                            string(
                                defaultValue: '{version}+ios',
                                description: 'Apple Browsers iOS release tag template',
                                name: 'APPLE_IOS_RELEASE_TAG_TEMPLATE'
                            ),
                            booleanParam(
                                defaultValue: true,
                                description: 'Run Apple (macOS and iOS) validation',
                                name: 'RUN_APPLE_VALIDATION'
                            ),
                            string(
                                defaultValue: 'develop',
                                description: 'Android',
                                name: 'ANDROID_BRANCH'
                            ),
                            string(
                                defaultValue: '{version}',
                                description: 'Android release tag template',
                                name: 'ANDROID_RELEASE_TAG_TEMPLATE'
                            ),
                            booleanParam(
                                defaultValue: true,
                                description: 'Run Android validation',
                                name: 'RUN_ANDROID_VALIDATION'
                            ),
                            string(
                                defaultValue: 'main',
                                description: 'Asana Utils Branch',
                                name: 'ASANA_UTILS_BRANCH'
                            ),
                            string(
                                defaultValue: '1210856607616307',
                                description: 'Asana project for validation reports',
                                name: 'ASANA_PROJECT'
                            ),
                            booleanParam(
                                defaultValue: true,
                                description: 'Notify pixel owners in their Asana tasks via internal-github-asana-utils',
                                name: 'NOTIFY_PIXEL_OWNERS'
                            )
                        ])
                    ])
                }
            }
        }
        stage('Checkout repositories') {
            steps {
                script {
                    dir('pixel-schema') {
                        checkout([$class: 'GitSCM', branches: [[name: "${params.PIXEL_SCHEMA_BRANCH}"]],
                            extensions: [[$class: 'LocalBranch'], [$class: 'CleanBeforeCheckout'], [$class: 'PruneStaleBranch']],
                            userRemoteConfigs: [[url: 'https://github.com/duckduckgo/pixel-schema.git']]])
                    }
                    dir('internal-github-asana-utils') {
                        checkout([$class: 'GitSCM', branches: [[name: "${params.ASANA_UTILS_BRANCH}"]],
                            extensions: [[$class: 'LocalBranch'], [$class: 'CleanBeforeCheckout'], [$class: 'PruneStaleBranch']],
                            userRemoteConfigs: [[credentialsId: 'windows-browser-rw', url: 'https://github.com/duckduckgo/internal-github-asana-utils.git']]])
                    }

                    def configs = validationConfigs(params).findAll { it.enabled }
                    configs.groupBy { it.repo }.each { repo, repoConfigs ->
                        def config = repoConfigs[0]
                        echo "Checking out ${config.repo} HEAD from ${config.branch}"
                        dir(repo) {
                            checkout([$class: 'GitSCM', branches: [[name: "${config.branch}"]],
                                extensions: [[$class: 'LocalBranch'], [$class: 'CleanBeforeCheckout'], [$class: 'PruneStaleBranch']],
                                userRemoteConfigs: [remoteConfig(config)]])
                        }
                    }

                    sh '''#!/bin/bash
                        cd pixel-schema
                        fnm install
                        fnm exec npm ci
                    '''

                    configs.each { config ->
                        def headDefinitionsDir = "../${config.repo}/${config.definitionsDir}/"
                        def releaseOutput = withEnv([
                            "MAIN_DIR=${headDefinitionsDir}",
                            "RELEASE_TAG_TEMPLATE=${config.tagTemplate}",
                        ]) {
                            sh(
                                script: '''#!/bin/bash
                                    cd pixel-schema
                                    fnm exec node ./scripts/resolve_release_tag.mjs "$MAIN_DIR" "$RELEASE_TAG_TEMPLATE"
                                ''',
                                returnStdout: true
                            ).trim()
                        }

                        if (!releaseOutput) {
                            echo "No application version target for ${config.name}; validating HEAD only"
                            return
                        }

                        def releaseValues = releaseOutput.readLines()
                        if (releaseValues.size() != 2) {
                            error("Unexpected release resolver output for ${config.name}: ${releaseOutput}")
                        }
                        def releaseVersion = releaseValues[0]
                        def releaseTag = releaseValues[1]
                        echo "Checking out ${config.name} release ${releaseVersion} from tag ${releaseTag}"
                        dir("release-${config.name.replaceAll(/[^A-Za-z0-9-]/, '-')}") {
                            checkout([$class: 'GitSCM', branches: [[name: "refs/tags/${releaseTag}"]],
                                extensions: [[$class: 'CleanBeforeCheckout'], [$class: 'PruneStaleBranch']],
                                userRemoteConfigs: [remoteConfig(config)]])
                        }
                    }
                }
            }
        }
        stage('Confirm settings') {
            steps {
                sh '''#!/bin/bash
                    echo "User map: $USER_MAP"
                    echo "Asana Project: $ASANA_PROJECT"
                '''
            }
        }
        stage('Validate products') {
            steps {
                script {
                    validationConfigs(params).findAll { it.enabled }.each { config ->
                        def releaseCheckoutDir = "release-${config.name.replaceAll(/[^A-Za-z0-9-]/, '-')}"
                        def releaseDefinitionsDir = fileExists("${releaseCheckoutDir}/${config.definitionsDir}")
                            ? "../${releaseCheckoutDir}/${config.definitionsDir}/"
                            : ''
                        def result = withEnv([
                            "MAIN_DIR=../${config.repo}/${config.definitionsDir}/",
                            "RELEASE_MAIN_DIR=${releaseDefinitionsDir}",
                        ]) {
                            sh(
                                script: '''#!/bin/bash
                                    cd pixel-schema
                                    echo "Starting validation for $MAIN_DIR..."
                                    ./scripts/validateRepo.sh "$MAIN_DIR" "$USER_MAP" "$ASANA_PROJECT" "$RELEASE_MAIN_DIR"
                                ''',
                                returnStatus: true
                            )
                        }
                        if (result != 0) {
                            echo "WARNING: validateRepo.sh failed for ${config.name} with exit code: ${result}"
                            unstable("Validation failed for ${config.name}")
                        }
                    }
                }
            }
        }
        stage('Delete old attachments from Asana') {
            steps {
                script {
                    def result = sh(
                        script: '''#!/bin/bash
                            cd pixel-schema
                            echo "Deleting old attachments from Asana..."
                            fnm exec npm run delete-attachments "$ASANA_PROJECT"
                        ''',
                        returnStatus: true
                    )
                    if (result != 0) {
                        error("delete-attachments failed with exit code: ${result}")
                    }
                }
            }
        }
    }
    post {
        failure {
            script {
                sh '''#!/bin/bash
                    echo "Attempting to create Asana task for failure..."
                    DATE=`date --rfc-3339=seconds | sed -e 's/ /-/g'`
                    echo $DATE

                    ddg-perl /usr/local/ddg/sysadmin/scripts/asana_create_task.pl \
                            --assignee ladamski@duckduckgo.com \
                            --description "Pixel validation failed see console output at https://jenkins.duckduckgo.com/job/PixelValidation/" \
                            --project_id $ASANA_PROJECT \
                            "Pixel validation failed $DATE"
                '''
            }
        }
    }
}
