{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "pixel.schema.json",
    "title": "Pixel",
    "description": "A schema defining how DDG pixels are triggered and what data they send",
    "type": "object",
    "propertyNames": {
        "not": {
            "anyOf": [
                {
                    "type": "string",
                    "pattern": "^experiment\\." // Experiments must be defined separately
                },
                {
                    "type": "string",
                    "pattern": ".*\\..*" // `.` not allowed - pixel names must use `_` instead
                }
            ]
        }
    },
    "additionalProperties": {
        "$ref": "#/$defs/pixel"
    },
    "$defs": {
        "pixel": {
            "type": "object",
            "required": ["description", "owners"],
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string",
                    "description": "A description of when the pixel fires and its purpose"
                },
                "owners": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Usernames of the people responsible for this pixel",
                    "items": {
                        "type": "string"
                    }
                },
                "triggers": {
                    "type": "array",
                    "minItems": 1,
                    "description": "What triggers this pixel",
                    "default": ["other"],
                    "items": {
                        "type": "string",
                        // See docs/trigger-classification.md for how to choose the right trigger(s)
                        "enum": [
                            "page_load", // pixel fires when a webpage is loaded
                            "new_tab", // pixel fires when a new tab is opened
                            "search_ddg", // pixel fires when user performs a search
                            "startup", // pixel fires on app startup or return to foreground
                            "scheduled", // pixel fires periodically (a timer or scheduled job literally fires it)
                            "user_interaction", // pixel fires on a deliberate user action in the UI: tap/click, toggle, menu selection, swipe, gesture, prompt/query submission
                            "user_submitted", // pixel fires when the user submits their data with consent (e.g. breakage report, feedback)
                            "impression", // pixel fires when a screen, promo, prompt, dialog, or message is shown to the user without interaction (app/eligibility-driven display)
                            "feature_lifecycle", // pixel fires when an automatic feature operation runs, completes, or changes state: migrations, sync cycles, job engines, token refreshes, install/update detection, state observers
                            "web_detection", // pixel fires when injected scripts detect content or behavior on a web page: captcha, adwall, CMP, ad-blocking detection
                            "exception", // pixel fires when an exception/crash occurs
                            "other" // last resort - explain in the description why no other trigger fits
                        ]
                    }
                },
                "suffixes": {
                    "type": "array",
                    "description": "List of pixel suffix combinations under the main pixel prefix. Can be a shortcut to a common suffix",
                    "items": {
                        "$ref": "suffix.schema.json#/$defs/suffix"
                    }
                },
                "parameters": {
                    "type": "array",
                    "description": "List of parameters sent by this pixel. Can be a shortcut to a common parameter",
                    "items": {
                        "$ref": "param.schema.json#/$defs/param"
                    }
                },
                "privacyReview": {
                    "type": "array",
                    "description": "Link(s) to a privacy review(s) of this pixel",
                    "items": {
                        "type": "string",
                        "format": "uri"
                    }
                },
                "expires": {
                    "type": "string",
                    "description": "The date this pixel is no longer valid",
                    "format": "date"
                },
                "grafanaDashboards": {
                    "type": "array",
                    "description": "Link(s) to Grafana dashboards that use this pixel",
                    "items": {
                        "type": "string",
                        "format": "uri"
                    }
                }
            }
        }
    }
}
